# FraudLens environment keys — the "coding expert" live path.
#
# The demo is replay-first: it never depends on these. When set, the live path
# wires the real Corti Agent API (the coding-expert registry connector) behind
# the same Pipeline interface, so the hero case runs against real models while
# every other case stays on cached replay.
#
# Source of truth: the agent-eval-cases repo's .env. Copy that .env here as
# app/.env (gitignored). Empty/unset → pure replay, FRAUDLENS_LIVE inert.

# ── Corti Agent API (the coding-expert backbone) ─────────────────────────
# Region selection: CORTI_REGION picks which *_<REGION> block is read.
# Use staging-eu — it has credits and completes a coding-expert run end-to-end
# (verified 2026-09-16). `eu` is out of credits (task REJECTED); dev-weu also
# works but its message:send is intermittently flaky.
CORTI_REGION=staging-eu
CORTI_TENANT_NAME=base

# Per-region credentials (only the active region's block is required):
AGENT_API_URL_DEV_WEU=https://api.dev-weu.corti.app
AGENT_API_AUTH_URL_DEV_WEU=https://auth.dev-weu.corti.app
AGENT_API_CLIENT_ID_DEV_WEU=
AGENT_API_CLIENT_SECRET_DEV_WEU=

AGENT_API_URL_EU=https://api.eu.corti.app
AGENT_API_AUTH_URL_EU=https://auth.eu.corti.app
AGENT_API_CLIENT_ID_EU=
AGENT_API_CLIENT_SECRET_EU=

# staging-eu / us follow the same AGENT_API_*_<REGION> pattern.

# ── Opik dev tracing (optional) ─────────────────────────────────────────
# Set FRAUDLENS_TRACING=1 to emit Opik traces/spans around each pipeline step
# (codes.predict, retrace, judgement, legal brief) so you can watch the agents
# in the Opik UI. Off by default — the demo critical path is unaffected, and
# tracing falls back to a no-op if Opik is unreachable.
FRAUDLENS_TRACING=
OPIK_API_KEY=
OPIK_URL_OVERRIDE=
OPIK_PROJECT_NAME=FraudLens
OPIK_WORKSPACE=default
# OPIK_URL_DEV_WEU + OPIK_PROJECT_ID_DEV_WEU come from the agent-eval-cases .env.

# ── Live-path controls ───────────────────────────────────────────────────
# 1 = run the hero case against the real coding expert; 0 (default) = replay.
FRAUDLENS_LIVE=0
# Hard timeout (ms) before falling back to the cached replay result.
FRAUDLENS_LIVE_TIMEOUT_MS=8000
# Which case runs live (defaults to the villain's flagship upcoding+unbundling case).
FRAUDLENS_LIVE_CASE=C-2026-0042
